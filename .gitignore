# OS
.DS_Store

# Editors
.idea/
.vscode/
tempCodeRunnerFile.py

# Python (app/)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments & local env config
.venv/
venv/
env/
.env
.envrc

# MkDocs build output
/site/

# Helm vendored dependencies (`helm dependency update` drops .tgz files here;
# Chart.lock stays tracked for reproducible installs)
deploy/charts/*/charts/

# Secrets & local artifacts (Steps 0, 15, 18, 25)
secrets.yaml            # secrets.example.yaml stays tracked
*-key.pem               # mkcert/openssl private keys
*.local.pem             # mkcert certs
dump.sql                # pg_dump output
*.kubeconfig            # exported kubeconfigs
